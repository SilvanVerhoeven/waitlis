// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model User {
  id          String    @id @default(cuid())
  name        String    @unique
  password    String
  displayName String?
  role        Role      @default(USER)
  Session     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

enum PhaseStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  ACTIVE
  NEXT
  QUEUED
  HANDLED
  SKIPPED
  DECLINED
  WITHDRAWN
}

model Tag {
  id            Int            @id @default(autoincrement())
  name          String
  queue         Queue[]
  registrations Registration[]
}

model Member {
  id                 String         @id @default(cuid())
  secret             String
  displayName        String?
  createdAt          DateTime       @default(now())
  lastRegistrationAt DateTime       @updatedAt
  registrations      Registration[]
}

model Queue {
  id            Int            @id @default(autoincrement())
  name          String?
  createdAt     DateTime       @default(now())
  tags          Tag[]
  registrations Registration[]
}

model Lane {
  id        Int       @id @default(autoincrement())
  condition String
  createdAt DateTime  @default(now())
  segments  Segment[]
  merge     Merge?    @relation(fields: [mergeId], references: [id])
  mergeId   Int?
}

model Segment {
  id        Int    @id @default(autoincrement())
  condition String
  lane      Lane   @relation(fields: [laneId], references: [id])
  laneId    Int
}

model Merge {
  id    Int    @id @default(autoincrement())
  lanes Lane[]
}

model Registration {
  id        Int                @id @default(autoincrement())
  status    RegistrationStatus
  tags      Tag[]
  member    Member             @relation(fields: [memberId], references: [id])
  phase     Phase              @relation(fields: [phaseId], references: [id])
  queue     Queue              @relation(fields: [queueId], references: [id])
  createdAt DateTime           @default(now())
  phaseId   Int
  memberId  String
  queueId   Int
}

model Phase {
  id            Int            @id @default(autoincrement())
  name          String?
  status        PhaseStatus
  isCurrent     Boolean        @default(false)
  registrations Registration[]
  previous      Phase?         @relation("PhaseHistory", fields: [previousId], references: [id])
  createdAt     DateTime       @default(now())
  previousId    Int?           @unique
  next          Phase?         @relation("PhaseHistory")
}
