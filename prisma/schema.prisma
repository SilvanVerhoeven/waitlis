// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model User {
  id          String    @id @default(cuid())
  name        String    @unique
  password    String
  displayName String?
  role        Role      @default(USER)
  Session     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

enum PhaseStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  ACTIVE
  NEXT
  QUEUED
  HANDLED
  SKIPPED
  DECLINED
  WITHDRAWN
}

model Tag {
  name          String         @id
  queues        Queue?         @relation(fields: [queueId], references: [id])
  queueId       Int?
  registrations Registration[]
}

model Member {
  id                 String         @id @default(cuid())
  createdAt          DateTime       @default(now())
  lastRegistrationAt DateTime       @updatedAt
  registrations      Registration[]
}

model Queue {
  id            Int            @id @default(autoincrement())
  name          String?
  createdAt     DateTime       @default(now())
  tags          Tag[]
  registrations Registration[]
}

model Registration {
  id           Int                @id @default(autoincrement())
  status       RegistrationStatus
  firstInPhase Boolean
  tags         Tag[]
  member       Member             @relation(fields: [memberId], references: [id])
  queue        Queue              @relation(fields: [queueId], references: [id])
  phase        Phase              @relation(fields: [phaseId], references: [id])
  createdAt    DateTime           @default(now())
  queueId      Int
  phaseId      Int
  memberId     String
}

model Phase {
  id            Int            @id @default(autoincrement())
  name          String?
  status        PhaseStatus
  isCurrent     Boolean        @default(false)
  registrations Registration[]
  previous      Phase?         @relation("PhaseHistory", fields: [previousId], references: [id])
  createdAt     DateTime       @default(now())
  previousId    Int?           @unique
  next          Phase?         @relation("PhaseHistory")
}
